{
  "jupyter.lab.setting-icon": "whybook:epinotebook",
  "jupyter.lab.setting-icon-label": "Whybook toolbar",
  "title": "Whybook toolbar",
  "description": "The items of the toolbar of a notebook opened in Whybook.",
  "jupyter.lab.toolbars": {
    "Whybook": [
      { "name": "epi-view", "rank": 10 },
      { "name": "epi-mode", "rank": 20 },
      { "name": "epi-layout", "rank": 30 },
      { "name": "epi-detail", "rank": 40 },
      { "name": "epi-run-all", "rank": 50 },
      { "name": "epi-ai", "rank": 60 },
      { "name": "spacer", "type": "spacer", "rank": 100 },
      { "name": "kernelName", "rank": 1000 },
      { "name": "executionProgress", "rank": 1001 }
    ]
  },
  "jupyter.lab.transform": true,
  "properties": {
    "toolbar": {
      "title": "Whybook toolbar items",
      "description": "Leave an item out with \"disabled\": true, or add the button of a command with a name, the command and a rank. Whybook's own commands act on its view, such as whybook:restart-kernel.",
      "items": {
        "$ref": "#/definitions/toolbarItem"
      },
      "type": "array",
      "default": []
    }
  },
  "additionalProperties": false,
  "type": "object",
  "definitions": {
    "toolbarItem": {
      "properties": {
        "name": {
          "title": "Unique name",
          "type": "string"
        },
        "args": {
          "title": "Command arguments",
          "type": "object"
        },
        "command": {
          "title": "Command id",
          "type": "string",
          "default": ""
        },
        "disabled": {
          "title": "Whether the item is left out",
          "type": "boolean",
          "default": false
        },
        "icon": {
          "title": "Item icon id",
          "description": "If given, it replaces the icon of the command.",
          "type": "string"
        },
        "label": {
          "title": "Item label",
          "description": "If given, it replaces the label of the command.",
          "type": "string"
        },
        "caption": {
          "title": "Item caption",
          "description": "If given, it replaces the caption of the command.",
          "type": "string"
        },
        "type": {
          "title": "Item type",
          "type": "string",
          "oneOf": [
            { "const": "command", "title": "Command" },
            { "const": "spacer", "title": "Spacer" }
          ]
        },
        "rank": {
          "title": "Item rank",
          "type": "number",
          "minimum": 0,
          "default": 50
        }
      },
      "required": ["name"],
      "additionalProperties": false,
      "type": "object"
    }
  }
}
